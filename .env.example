# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# Kimi API key（必填，用于打分和摘要）：https://platform.moonshot.cn → API Key 管理
MOONSHOT_API_KEY=
# Semantic Scholar API key（强烈建议，无 key 时限流很慢）：https://www.semanticscholar.org/product/api 免费申请
S2_KEY=
# 163 邮箱（真实发信测试时需要；--dry-run 不需要）
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
# 账号登记表加密密钥（多账号模式用；python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())" 生成）
FERNET_KEY=
